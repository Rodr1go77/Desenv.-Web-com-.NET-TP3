@page
@model IndexModel
@{
	ViewData["Title"] = "Home page";
}

<div>
	<h1>Lista de Cidades e Hotéis</h1>

	<div class="divprincipal">

		@foreach (var city in Model.Cities)
		{
			<div class="bloco-item">
				<p class="mb-0"><strong>Nome da cidade: </strong> @city.Name - <strong> País: </strong> @city.Country?.CountryName</p>
				@foreach (var nomeHotel in city.Properties)
				{
					<p class= "mb-0">
						<strong>ID: @nomeHotel.Id</strong> <br /> Nome do hotel: @nomeHotel.Name <br />
						Valor Diária: @nomeHotel.PricePerNight.ToString("C")
					</p>

				}

			</div>

		}
	</div>
</div>
